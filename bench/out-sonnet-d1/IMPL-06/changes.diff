+/// Build the merged, seq-ordered, cursor-filtered snapshot frames: the node-resume
+/// frames (`snapshot_frames`, unfiltered — the S6 node-frame shape) MERGED with the
+/// folded rich transcript (`fold_rich_frames`), then cursor-filtered ONCE over the
+/// combined list.
+///
+/// For a no-rich task `events` carries no `Plan`/`ToolCall`/`ToolCallUpdate` rows,
+/// so `fold_rich_frames` returns empty and this is byte-identical to
+/// `snapshot_frames(snap, cursor)` (the S6 golden holds).
+fn rich_snapshot_frames(
+    snap: &bridge_core::task_store::TaskProgressSnapshot,
+    events: &[bridge_core::orch::OrchEvent],
+    cursor: Option<i64>,
+) -> Vec<crate::reattach::WorkflowProgressFrame> {
+    let mut frames = snapshot_frames(snap, None);
+    frames.extend(fold_rich_frames(events));
+    frames.sort_by_key(|f| f.seq);
+    if let Some(k) = cursor {
+        frames.retain(|f| f.seq > k);
+    }
+    frames
+}
+
+/// Fold the rich journal events (`Plan`/`ToolCall`/`ToolCallUpdate`) into
+/// snapshot-phase frames:
+/// - Keep only the LATEST `Plan` → one `FrameKind::Plan` frame at that seq.
+/// - Per `tool_call_id`, walk in seq order: a `ToolCall` sets/replaces the base
+///   state; a `ToolCallUpdate` sparsely patches present fields onto it (`Some`
+///   replaces, including `Some` of an empty value; `None` leaves the field
+///   untouched). At the end, per id: if a base `ToolCall` was seen, emit ONE
+///   `FrameKind::ToolCall` (merged current state) at the LAST-applied seq; else
+///   (an orphan update with no prior base) emit a `FrameKind::ToolCallUpdate` at
+///   its last-applied seq.
+///
+/// (Mode/config/commands events are out of scope for S7a — they never appear in
+/// `events`.)
+fn fold_rich_frames(
+    events: &[bridge_core::orch::OrchEvent],
+) -> Vec<crate::reattach::WorkflowProgressFrame> {
+    use bridge_core::orch::OrchEventKind;
+
+    #[derive(Default)]
+    struct ToolState {
+        title: Option<String>,
+        kind: Option<String>,
+        status: Option<String>,
+        locations: Option<Vec<String>>,
+        content: Option<bridge_core::orch::ContentSummary>,
+        last_seq: i64,
+        had_base: bool,
+    }
+
+    let mut latest_plan: Option<(i64, Vec<bridge_core::orch::PlanEntry>)> = None;
+    let mut tool_states: HashMap<String, ToolState> = HashMap::new();
+
+    for event in events {
+        match &event.kind {
+            OrchEventKind::Plan { entries } => {
+                latest_plan = Some((event.seq, entries.clone()));
+            }
+            OrchEventKind::ToolCall {
+                tool_call_id,
+                title,
+                kind,
+                status,
+                locations,
+                content,
+            } => {
+                let st = tool_states.entry(tool_call_id.clone()).or_default();
+                st.title = Some(title.clone());
+                st.kind = Some(kind.clone());
+                st.status = Some(status.clone());
+                st.locations = Some(locations.clone());
+                st.content = content.clone();
+                st.last_seq = event.seq;
+                st.had_base = true;
+            }
+            OrchEventKind::ToolCallUpdate {
+                tool_call_id,
+                title,
+                kind,
+                status,
+                locations,
+                content,
+            } => {
+                let st = tool_states.entry(tool_call_id.clone()).or_default();
+                if title.is_some() {
+                    st.title = title.clone();
+                }
+                if kind.is_some() {
+                    st.kind = kind.clone();
+                }
+                if status.is_some() {
+                    st.status = status.clone();
+                }
+                if locations.is_some() {
+                    st.locations = locations.clone();
+                }
+                if content.is_some() {
+                    st.content = content.clone();
+                }
+                st.last_seq = event.seq;
+            }
+            OrchEventKind::NodeStarted { .. }
+            | OrchEventKind::NodeFinished { .. }
+            | OrchEventKind::Terminal { .. }
+            | OrchEventKind::Progress { .. }
+            | OrchEventKind::Usage { .. } => {}
+        }
+    }
+
+    let mut out = Vec::new();
+    if let Some((seq, entries)) = latest_plan {
+        out.push(crate::reattach::frame_from_orch(
+            &OrchEventKind::Plan { entries },
+            crate::reattach::Phase::Snapshot,
+            seq,
+        ));
+    }
+    for (tool_call_id, st) in tool_states {
+        let kind = if st.had_base {
+            OrchEventKind::ToolCall {
+                tool_call_id,
+                title: st.title.unwrap_or_default(),
+                kind: st.kind.unwrap_or_default(),
+                status: st.status.unwrap_or_default(),
+                locations: st.locations.unwrap_or_default(),
+                content: st.content,
+            }
+        } else {
+            OrchEventKind::ToolCallUpdate {
+                tool_call_id,
+                title: st.title,
+                kind: st.kind,
+                status: st.status,
+                locations: st.locations,
+                content: st.content,
+            }
+        };
+        out.push(crate::reattach::frame_from_orch(
+            &kind,
+            crate::reattach::Phase::Snapshot,
+            st.last_seq,
+        ));
+    }
+    out
+}
