+/// SPIKE-ONLY (throwaway measurement, not part of any shipped slice): re-derives
+/// the `(scope, name, ns)` rib the way `scope_member_lookup_probed` does, and
+/// returns `true` iff every candidate is *known*-hidden (`spike_member_visible_tri`
+/// returns `Hidden`) rather than `Unknown`. Read-only; does not affect resolution.
+fn spike_classify_member_rib_all_hidden(
+    graph: &ScopeGraph,
+    scope: ScopeId,
+    q: &ResolveQuery,
+    policy: &dyn ResolutionPolicy,
+) -> bool {
+    let rib: Vec<usize> = graph
+        .bindings
+        .iter()
+        .enumerate()
+        .filter(|(_, b)| b.scope == scope && b.name == q.name && b.ns == q.ns)
+        .filter(|(_, b)| cfg_compatible(&b.cond))
+        .map(|(i, _)| i)
+        .collect();
+    rib.iter().all(|&bidx| {
+        let b = &graph.bindings[bidx];
+        let trav = TraversalCtx {
+            lookup_scope: Some(b.scope),
+            via_glob: false,
+            edge_kind: None,
+        };
+        matches!(
+            policy.spike_member_visible_tri(b, q, &trav),
+            GlobEdgeVis::Hidden
+        )
+    })
+}
