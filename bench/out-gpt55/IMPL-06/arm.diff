+#[derive(Default)]
+struct ToolCallFold {
+    title: Option<String>,
+    kind: Option<String>,
+    status: Option<String>,
+    locations: Option<Vec<String>>,
+    content: Option<bridge_core::orch::ContentSummary>,
+    last_seq: i64,
+    had_base: bool,
+}
+
+/// Build the ordered, cursor-filtered snapshot phase with folded rich transcript frames.
+///
+/// Node frames continue to come from [`snapshot_frames`] with no cursor so the S6
+/// no-rich projection remains byte-identical. Rich frames are folded from the same
+/// journal read that produced the node snapshot, merged by seq, and cursor-filtered
+/// once after the merge.
+fn rich_snapshot_frames(
+    snap: &bridge_core::task_store::TaskProgressSnapshot,
+    events: &[bridge_core::orch::OrchEvent],
+    cursor: Option<i64>,
+) -> Vec<crate::reattach::WorkflowProgressFrame> {
+    let mut frames = snapshot_frames(snap, None);
+    let mut latest_plan: Option<(i64, Vec<bridge_core::orch::PlanEntry>)> = None;
+    let mut tool_calls: HashMap<String, ToolCallFold> = HashMap::new();
+
+    for event in events {
+        match &event.kind {
+            bridge_core::orch::OrchEventKind::Plan { entries } => {
+                latest_plan = Some((event.seq, entries.clone()));
+            }
+            bridge_core::orch::OrchEventKind::ToolCall {
+                tool_call_id,
+                title,
+                kind,
+                status,
+                locations,
+                content,
+            } => {
+                tool_calls.insert(
+                    tool_call_id.clone(),
+                    ToolCallFold {
+                        title: Some(title.clone()),
+                        kind: Some(kind.clone()),
+                        status: Some(status.clone()),
+                        locations: Some(locations.clone()),
+                        content: content.clone(),
+                        last_seq: event.seq,
+                        had_base: true,
+                    },
+                );
+            }
+            bridge_core::orch::OrchEventKind::ToolCallUpdate {
+                tool_call_id,
+                title,
+                kind,
+                status,
+                locations,
+                content,
+            } => {
+                let state = tool_calls.entry(tool_call_id.clone()).or_default();
+                if let Some(title) = title {
+                    state.title = Some(title.clone());
+                }
+                if let Some(kind) = kind {
+                    state.kind = Some(kind.clone());
+                }
+                if let Some(status) = status {
+                    state.status = Some(status.clone());
+                }
+                if let Some(locations) = locations {
+                    state.locations = Some(locations.clone());
+                }
+                if let Some(content) = content {
+                    state.content = Some(content.clone());
+                }
+                state.last_seq = event.seq;
+            }
+            _ => {}
+        }
+    }
+
+    if let Some((seq, entries)) = latest_plan {
+        let kind = bridge_core::orch::OrchEventKind::Plan { entries };
+        frames.push(crate::reattach::frame_from_orch(
+            &kind,
+            crate::reattach::Phase::Snapshot,
+            seq,
+        ));
+    }
+
+    for (tool_call_id, state) in tool_calls {
+        let kind = if state.had_base {
+            bridge_core::orch::OrchEventKind::ToolCall {
+                tool_call_id,
+                title: state.title.unwrap_or_default(),
+                kind: state.kind.unwrap_or_else(|| "other".to_string()),
+                status: state.status.unwrap_or_else(|| "pending".to_string()),
+                locations: state.locations.unwrap_or_default(),
+                content: state.content,
+            }
+        } else {
+            bridge_core::orch::OrchEventKind::ToolCallUpdate {
+                tool_call_id,
+                title: state.title,
+                kind: state.kind,
+                status: state.status,
+                locations: state.locations,
+                content: state.content,
+            }
+        };
+        frames.push(crate::reattach::frame_from_orch(
+            &kind,
+            crate::reattach::Phase::Snapshot,
+            state.last_seq,
+        ));
+    }
+
+    frames.sort_by_key(|f| f.seq);
+    if let Some(cursor) = cursor {
+        frames.retain(|frame| frame.seq > cursor);
+    }
+    frames
+}
