+    #[tokio::test]
+    async fn no_watchdog_config_is_byte_identical() {
+        // With watchdog disabled, no watchdog task or select arm can produce a
+        // timeout. A hung, no-output turn therefore remains pending like the
+        // pre-watchdog behavior.
+        let rec = Recorder::new("agent-sess-WD-NONE");
+        rec.gate_prompt.store(true, Ordering::SeqCst);
+        let be = connect_recording(rec.clone()).await;
+        let key = bkey("bridge-WD-NONE");
+
+        let mut s = be.prompt(&key, vec![]).await.unwrap();
+        assert!(
+            tokio::time::timeout(Duration::from_millis(150), s.next())
+                .await
+                .is_err(),
+            "disabled watchdog must leave a silent hung turn pending"
+        );
+        assert!(
+            rec.cancels.lock().await.is_empty(),
+            "disabled watchdog must not send session/cancel"
+        );
+    }
