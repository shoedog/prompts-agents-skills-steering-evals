+    #[tokio::test]
+    async fn watchdog_cancels_a_hung_turn_as_timed_out() {
+        // The agent accepts the prompt, emits nothing, and never returns. The
+        // hard wall-clock watchdog fires, sends session/cancel, waits only the
+        // configured grace, and the driver surfaces AgentTimedOut.
+        let rec = Recorder::new("agent-sess-WD-HUNG");
+        rec.gate_prompt.store(true, Ordering::SeqCst);
+        let cfg = AcpConfig {
+            cancel_grace: Duration::from_millis(50),
+            watchdog: Some(WatchdogConfig {
+                idle_timeout: Duration::from_secs(10),
+                hard_wall_clock: Duration::from_millis(50),
+            }),
+            ..test_config()
+        };
+        let be = connect_recording_with(rec.clone(), cfg).await;
+        let key = bkey("bridge-WD-HUNG");
+
+        let mut s = be.prompt(&key, vec![]).await.unwrap();
+        match tokio::time::timeout(Duration::from_secs(2), s.next())
+            .await
+            .expect("watchdog must terminate the hung turn")
+        {
+            Some(Err(BridgeError::AgentTimedOut)) => {}
+            other => panic!("expected terminal Err(AgentTimedOut), got {other:?}"),
+        }
+        assert!(s.next().await.is_none(), "stream terminates after timeout");
+
+        tokio::time::timeout(Duration::from_secs(2), rec.cancel_seen.notified())
+            .await
+            .expect("watchdog must send session/cancel before terminal timeout");
+        assert_eq!(rec.cancels.lock().await.as_slice(), &["agent-sess-WD-HUNG"]);
+    }
+
+    #[tokio::test]
+    async fn watchdog_does_not_trip_active_or_unmodeled_turn() {
+        let cfg = || AcpConfig {
+            cancel_grace: Duration::from_millis(50),
+            watchdog: Some(WatchdogConfig {
+                idle_timeout: Duration::from_millis(100),
+                hard_wall_clock: Duration::from_secs(10),
+            }),
+            ..test_config()
+        };
+
+        // (a) Modeled text chunks keep the turn active until it completes.
+        let rec = Recorder::new("agent-sess-WD-ACTIVE");
+        rec.set_updates(vec![
+            ScriptedUpdate::Text("a"),
+            ScriptedUpdate::Text("b"),
+            ScriptedUpdate::Text("c"),
+            ScriptedUpdate::Text("d"),
+            ScriptedUpdate::Text("e"),
+            ScriptedUpdate::Text("f"),
+        ])
+        .await;
+        rec.set_update_delay(Duration::from_millis(20)).await;
+        let be = connect_recording_with(rec, cfg()).await;
+        let key = bkey("bridge-WD-ACTIVE");
+        let mut s = be.prompt(&key, vec![]).await.unwrap();
+        let mut text = String::new();
+        let done = loop {
+            match tokio::time::timeout(Duration::from_secs(2), s.next())
+                .await
+                .expect("active text turn must not hang")
+            {
+                Some(Ok(Update::Text(t))) => text.push_str(&t),
+                Some(Ok(Update::Done { stop_reason })) => break stop_reason,
+                Some(other) => panic!("active text turn must not fail, got {other:?}"),
+                None => panic!("active text turn ended without Done"),
+            }
+        };
+        assert_eq!(text, "abcdef");
+        assert_eq!(done, "end_turn");
+        assert!(s.next().await.is_none());
+
+        // (b) Unmodeled thought chunks also bump activity even though the stream
+        // drops them; the turn should complete with only the terminal Done.
+        let rec = Recorder::new("agent-sess-WD-THOUGHT");
+        rec.set_updates(vec![
+            ScriptedUpdate::Thought("a"),
+            ScriptedUpdate::Thought("b"),
+            ScriptedUpdate::Thought("c"),
+            ScriptedUpdate::Thought("d"),
+            ScriptedUpdate::Thought("e"),
+            ScriptedUpdate::Thought("f"),
+        ])
+        .await;
+        rec.set_update_delay(Duration::from_millis(20)).await;
+        let be = connect_recording_with(rec, cfg()).await;
+        let key = bkey("bridge-WD-THOUGHT");
+        let mut s = be.prompt(&key, vec![]).await.unwrap();
+        match tokio::time::timeout(Duration::from_secs(2), s.next())
+            .await
+            .expect("unmodeled-only turn must complete")
+        {
+            Some(Ok(Update::Done { stop_reason })) => assert_eq!(stop_reason, "end_turn"),
+            other => panic!("expected only terminal Done for unmodeled-only turn, got {other:?}"),
+        }
+        assert!(s.next().await.is_none());
+    }
