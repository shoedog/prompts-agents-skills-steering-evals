+
+fn batch_status_as_str(status: &bridge_core::task_store::BatchStatus) -> &'static str {
+    use bridge_core::task_store::BatchStatus;
+    match status {
+        BatchStatus::Working => "working",
+        BatchStatus::Completed => "completed",
+        BatchStatus::Canceling => "canceling",
+        BatchStatus::Canceled => "canceled",
+        BatchStatus::Failed => "failed",
+    }
+}
+
+fn parse_batch_status(s: &str) -> Option<bridge_core::task_store::BatchStatus> {
+    use bridge_core::task_store::BatchStatus;
+    match s {
+        "working" => Some(BatchStatus::Working),
+        "completed" => Some(BatchStatus::Completed),
+        "canceling" => Some(BatchStatus::Canceling),
+        "canceled" => Some(BatchStatus::Canceled),
+        "failed" => Some(BatchStatus::Failed),
+        _ => None,
+    }
+}
+
+fn row_to_batch(row: &rusqlite::Row) -> rusqlite::Result<bridge_core::task_store::BatchRecord> {
+    let id: String = row.get(0)?;
+    let workflow: String = row.get(1)?;
+    let concurrency: i64 = row.get(2)?;
+    let total: i64 = row.get(3)?;
+    let status_s: String = row.get(4)?;
+    let items_json: String = row.get(5)?;
+    let error: Option<String> = row.get(6)?;
+    let created_ms: i64 = row.get(7)?;
+    let updated_ms: i64 = row.get(8)?;
+    let id = bridge_core::ids::BatchId::parse(id)
+        .map_err(|_| rusqlite::Error::InvalidQuery)?;
+    let status = parse_batch_status(&status_s).ok_or(rusqlite::Error::InvalidQuery)?;
+    Ok(bridge_core::task_store::BatchRecord {
+        id,
+        workflow,
+        concurrency: concurrency as u32,
+        total: total as u32,
+        status,
+        items_json,
+        error,
+        created_ms,
+        updated_ms,
     })
 }
 
