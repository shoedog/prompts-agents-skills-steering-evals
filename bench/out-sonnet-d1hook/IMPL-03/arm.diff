+            s.claim_batch_child(&bid, "x", &batch_child_record(&t1, &bid, "x"))
+                .await
+                .unwrap(),
+            ChildClaim::Created
+        );
+        s.set_terminal(&t1, TaskRecordStatus::Completed, Some("OUT"), None, 9)
+            .await
+            .unwrap();
+        // Re-claiming the same (batch, item) after the child went terminal must report
+        // ExistingTerminal (not ExistingWorking) so the admission loop does not re-spawn it,
+        // and must NOT insert a second row.
+        let t2 = tid("t2");
+        assert_eq!(
+            s.claim_batch_child(&bid, "x", &batch_child_record(&t2, &bid, "x"))
+                .await
+                .unwrap(),
+            ChildClaim::ExistingTerminal
+        );
+        assert_eq!(s.batch_children(&bid).await.unwrap().len(), 1);
+    }
+
+    #[tokio::test]
+    async fn sqlite_batch_cas_transitions() {
+        let s = SqliteStore::open_in_memory().unwrap();
+        let bid = BatchId::parse("b-cas").unwrap();
+        s.create_batch(&sample_batch(&bid, BatchStatus::Working, 1, 0))
+            .await
+            .unwrap();
+
+        // cancel_batch_if_working: Working -> Canceling succeeds once.
+        assert!(s.cancel_batch_if_working(&bid, 1).await.unwrap());
+        assert_eq!(
+            s.get_batch(&bid).await.unwrap().unwrap().status,
+            BatchStatus::Canceling
+        );
+        // A second cancel is a no-op (status is no longer Working).
+        assert!(!s.cancel_batch_if_working(&bid, 2).await.unwrap());
+
+        // settle_batch_if_status: CAS fails when `expect` doesn't match current status.
+        assert!(!s
+            .settle_batch_if_status(&bid, BatchStatus::Working, BatchStatus::Completed, 3)
+            .await
+            .unwrap());
+        assert_eq!(
+            s.get_batch(&bid).await.unwrap().unwrap().status,
+            BatchStatus::Canceling
+        );
+        // CAS succeeds when `expect` matches.
+        assert!(s
+            .settle_batch_if_status(&bid, BatchStatus::Canceling, BatchStatus::Canceled, 4)
+            .await
+            .unwrap());
+        let got = s.get_batch(&bid).await.unwrap().unwrap();
+        assert_eq!(got.status, BatchStatus::Canceled);
+        assert_eq!(got.updated_ms, 4);
+    }
+
+    #[tokio::test]
+    async fn sqlite_fail_batch_if_status() {
+        let s = SqliteStore::open_in_memory().unwrap();
+        let bid = BatchId::parse("b-fail").unwrap();
+        s.create_batch(&sample_batch(&bid, BatchStatus::Working, 1, 0))
+            .await
+            .unwrap();
+
+        assert!(s
+            .fail_batch_if_status(&bid, BatchStatus::Working, "bad plan", 7)
+            .await
+            .unwrap());
+        let got = s.get_batch(&bid).await.unwrap().unwrap();
+        assert_eq!(got.status, BatchStatus::Failed);
+        assert_eq!(got.error.as_deref(), Some("bad plan"));
+        assert_eq!(got.updated_ms, 7);
+        // Once Failed, a second fail_batch_if_status expecting Working is a no-op (CAS miss),
+        // and must not overwrite the recorded error.
+        assert!(!s
+            .fail_batch_if_status(&bid, BatchStatus::Working, "ignored", 8)
+            .await
+            .unwrap());
+        assert_eq!(
+            s.get_batch(&bid).await.unwrap().unwrap().error.as_deref(),
+            Some("bad plan")
+        );
+    }
+
+    #[tokio::test]
+    async fn sqlite_task_batch_fields_roundtrip_via_create() {
+        // batch_id/item_id must round-trip through the plain create()/get()/list() path too,
+        // not just through claim_batch_child's own INSERT.
+        let s = SqliteStore::open_in_memory().unwrap();
+        let bid = BatchId::parse("b-rt").unwrap();
+        s.create_batch(&sample_batch(&bid, BatchStatus::Working, 1, 0))
+            .await
+            .unwrap();
+        let mut rec = trec("child-rt", 1);
+        rec.batch_id = Some(bid.clone());
+        rec.item_id = Some("item-rt".to_string());
+        s.create(&rec).await.unwrap();
+
+        let got = s.get(&tid("child-rt")).await.unwrap().unwrap();
+        assert_eq!(got.batch_id, Some(bid.clone()));
+        assert_eq!(got.item_id.as_deref(), Some("item-rt"));
+
+        let listed = s.list(10).await.unwrap();
+        let found = listed.iter().find(|r| r.id.as_str() == "child-rt").unwrap();
+        assert_eq!(found.batch_id, Some(bid));
+        assert_eq!(found.item_id.as_deref(), Some("item-rt"));
+    }
