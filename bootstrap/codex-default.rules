# Approved commands (owner-directed 2026-08-07) — reduce approval prompts for
# the read-only and verify commands every session runs. Sandbox containment
# still applies; these affect approval only. Test changes with:
#   codex execpolicy check --pretty --rules ~/.codex/rules/default.rules -- <cmd>

# Read-only git
prefix_rule(pattern = ["git", "status"], decision = "allow")
prefix_rule(pattern = ["git", "diff"], decision = "allow")
prefix_rule(pattern = ["git", "log"], decision = "allow")
prefix_rule(pattern = ["git", "show"], decision = "allow")
prefix_rule(pattern = ["git", "branch"], decision = "allow")
prefix_rule(pattern = ["git", "worktree", "list"], decision = "allow")

# Read-only filesystem / search
prefix_rule(pattern = ["ls"], decision = "allow")
prefix_rule(pattern = ["rg"], decision = "allow")
prefix_rule(pattern = ["grep"], decision = "allow")
prefix_rule(pattern = ["find"], decision = "allow")
prefix_rule(pattern = ["cat"], decision = "allow")
prefix_rule(pattern = ["head"], decision = "allow")
prefix_rule(pattern = ["tail"], decision = "allow")
prefix_rule(pattern = ["wc"], decision = "allow")
prefix_rule(pattern = ["nl"], decision = "allow")

# Rust verify chain (the hermetic gates every bridge/stockTrading task runs)
prefix_rule(pattern = ["cargo", "fmt"], decision = "allow")
prefix_rule(pattern = ["cargo", "check"], decision = "allow")
prefix_rule(pattern = ["cargo", "clippy"], decision = "allow")
prefix_rule(pattern = ["cargo", "test"], decision = "allow")
prefix_rule(pattern = ["cargo", "build"], decision = "allow")

# TS verify chain (ssot-agents)
prefix_rule(pattern = ["npx", "tsc"], decision = "allow")
prefix_rule(pattern = ["node", "--import", "tsx", "--test"], decision = "allow")

# Never fetch/publish without asking (defense in depth alongside the sandbox)
prefix_rule(pattern = ["git", "push"], decision = "prompt")
prefix_rule(pattern = ["git", "fetch"], decision = "prompt")
prefix_rule(pattern = ["git", "pull"], decision = "prompt")
